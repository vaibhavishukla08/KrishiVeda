# Copy this file to backend/.env and fill in only what you need.
# Never commit backend/.env — it is listed in .gitignore.

# Database: SQLite is used when this is empty/commented out.
# DATABASE_URL=mysql+pymysql://krishiveda:change-me@localhost:3306/krishiveda?charset=utf8mb4

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Weather: if empty, the free Open-Meteo API (no key) is used instead.
# Get a key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Live mandi prices (AGMARKNET via data.gov.in). If empty, clearly-labelled DEMO prices are shown.
# Register at https://data.gov.in and copy your API key from "My Account".
DATA_GOV_IN_API_KEY=

# Expert Panel access code (experts type this to open /expert/panel and answer farmers' questions).
# Choose your own; leave empty to disable the panel. Replace with real expert logins later.
EXPERT_ACCESS_CODE=

# Farmer Advisory Assistant. If no key is set, the offline knowledge base is used.
# Google Gemini (free tier available): create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional alternative: Claude (used only if GEMINI_API_KEY is empty). https://console.anthropic.com
ANTHROPIC_API_KEY=
ADVISORY_MODEL=claude-opus-5-5

# Disease results below this confidence are shown as "not sure"
DISEASE_CONFIDENCE_THRESHOLD=0.70
MAX_UPLOAD_MB=5
